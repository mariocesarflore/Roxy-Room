1 ICON "src\\app.ico"

1 VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName",      "Roxy Team"
            VALUE "FileDescription",  "Roxy Room"
            VALUE "FileVersion",      "2.5.0.0"
            VALUE "InternalName",     "RoxyRoom"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Roxy Team"
            VALUE "OriginalFilename", "RoxyRoom.exe"
            VALUE "ProductName",      "Roxy Room"
            VALUE "ProductVersion",   "2.5.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
